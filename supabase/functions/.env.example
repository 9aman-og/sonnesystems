GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=openai/gpt-oss-120b
# Comma-separated Supabase auth UUIDs allowed to use the private Aero routes.
AERO_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000

# Hosted Supabase functions provide SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY automatically. Never put the service-role key in
# Lyfe, source control, or a browser environment.

# Local-only database URL used to read the existing Vault allowlist. Hosted
# deployment can use the project secret configuration instead.
SUPABASE_DB_URL=
